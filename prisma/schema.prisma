// ChurchOS Prisma Schema
// PostgreSQL database with Supabase Auth for authentication

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum MemberStatus {
  active
  inactive
  suspended
  transferred
}

enum TransactionStatus {
  pending
  success
  failed
  reversed
}

enum TransactionType {
  digital
  cash
  bank_transfer
}

enum EventType {
  service
  conference
  lifecycle
  training
  social
}

enum MessageDirection {
  inbound
  outbound
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum ConfidentialityLevel {
  standard
  confidential
  restricted
}

enum FormStatus {
  draft
  published
  closed
}

// ─── Core Models ─────────────────────────────────────────

model Church {
  id            String   @id @default(uuid())
  name          String
  denomination  String?
  address       String?
  city          String?
  state         String?
  country       String   @default("Nigeria")
  phone         String?
  email         String?
  website       String?
  logo_url      String?
  config        Json     @default("{}")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  branches          Branch[]
  profiles          Profile[]
  members           Member[]
  services          Service[]
  giving_categories GivingCategory[]
  transactions      Transaction[]
  events            Event[]
  messages          Message[]
  departments       Department[]
  cell_groups       CellGroup[]
  assets            Asset[]
  audit_logs        AuditLog[]
  church_configs    ChurchConfig[]

  @@map("churches")
}

model Branch {
  id          String   @id @default(uuid())
  church_id   String
  name        String
  is_headquarters Boolean @default(false)
  address     String?
  city        String?
  state       String?
  phone       String?
  email       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  church          Church          @relation(fields: [church_id], references: [id])
  profiles        Profile[]
  members         Member[]
  services        Service[]
  transactions    Transaction[]
  events          Event[]

  @@index([church_id])
  @@map("branches")
}

model Profile {
  id            String   @id @default(uuid())
  user_id       String   @unique // Supabase Auth user ID
  church_id     String
  branch_id     String?
  member_id     String?
  role          String   @default("member")
  first_name    String
  last_name     String
  phone         String?
  mfa_enabled   Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  church  Church @relation(fields: [church_id], references: [id])
  branch  Branch? @relation(fields: [branch_id], references: [id])
  member  Member? @relation(fields: [member_id], references: [id])

  @@index([church_id])
  @@index([user_id])
  @@map("profiles")
}

model Member {
  id              String       @id @default(uuid())
  church_id       String
  branch_id       String?
  first_name      String
  last_name       String
  email           String?
  phone           String?
  whatsapp_number String?
  date_of_birth   DateTime?
  gender          String?
  address         String?
  city            String?
  state           String?
  status          MemberStatus @default(active)
  member_since    DateTime     @default(now())
  photo_url       String?
  custom_fields   Json         @default("{}")
  notes           String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  church              Church              @relation(fields: [church_id], references: [id])
  branch              Branch?             @relation(fields: [branch_id], references: [id])
  profile             Profile?
  family_members      FamilyMember[]
  attendance          Attendance[]
  transactions        Transaction[]
  event_registrations EventRegistration[]
  risk_scores         RiskScore[]
  engagement_scores   EngagementScore[]
  life_events         LifeEvent[]
  pastoral_notes_from PastoralNote[]      @relation("Author")
  pastoral_notes_about PastoralNote[]     @relation("Subject")

  @@index([church_id, branch_id, status])
  @@index([phone])
  @@index([whatsapp_number])
  @@map("members")
}

model Family {
  id          String   @id @default(uuid())
  church_id   String
  name        String
  head_id     String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  family_members FamilyMember[]

  @@index([church_id])
  @@map("families")
}

model FamilyMember {
  id            String   @id @default(uuid())
  family_id     String
  member_id     String
  relationship  String   // e.g., "spouse", "child", "parent"
  is_head       Boolean  @default(false)
  created_at    DateTime @default(now())

  family Family @relation(fields: [family_id], references: [id])
  member Member @relation(fields: [member_id], references: [id])

  @@unique([family_id, member_id])
  @@map("family_members")
}

// ─── Attendance ──────────────────────────────────────────

model Service {
  id          String   @id @default(uuid())
  church_id   String
  branch_id   String?
  name        String   // e.g., "Sunday Service", "Wednesday Bible Study"
  day_of_week Int?     // 0=Sunday, 6=Saturday
  start_time  DateTime?
  end_time    DateTime?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  church     Church       @relation(fields: [church_id], references: [id])
  branch     Branch?      @relation(fields: [branch_id], references: [id])
  attendance Attendance[]

  @@index([church_id, branch_id])
  @@map("services")
}

model Attendance {
  id          String   @id @default(uuid())
  church_id   String
  service_id  String
  member_id   String?
  visitor_name String?
  checkin_at  DateTime @default(now())
  source      String   @default("manual") // manual, whatsapp, qr
  created_at  DateTime @default(now())

  church  Church  @relation(fields: [church_id], references: [id])
  service Service @relation(fields: [service_id], references: [id])
  member  Member? @relation(fields: [member_id], references: [id])

  @@unique([service_id, member_id]) // One check-in per service per member
  @@index([church_id, service_id, checkin_at])
  @@map("attendance")
}

// ─── Giving & Finance ────────────────────────────────────

model GivingCategory {
  id               String   @id @default(uuid())
  church_id        String
  name             String
  description      String?
  display_order    Int      @default(0)
  is_recurring     Boolean  @default(false)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  church       Church        @relation(fields: [church_id], references: [id])
  transactions Transaction[]

  @@index([church_id])
  @@map("giving_categories")
}

model Transaction {
  id                String          @id @default(uuid())
  church_id         String
  branch_id         String?
  member_id         String?
  category_id       String
  amount            Float
  currency          String          @default("NGN")
  type              TransactionType @default(digital)
  status            TransactionStatus @default(pending)
  payment_reference String?         @unique
  payment_method    String?         // paystack, flutterwave, cash, bank_transfer
  receipt_number    String?
  receipt_url       String?
  metadata          Json            @default("{}")
  notes             String?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  church  Church          @relation(fields: [church_id], references: [id])
  branch  Branch?         @relation(fields: [branch_id], references: [id])
  member  Member?         @relation(fields: [member_id], references: [id])
  category GivingCategory @relation(fields: [category_id], references: [id])

  @@index([church_id, member_id, created_at])
  @@index([payment_reference])
  @@map("transactions")
}

model RecurringGiving {
  id                    String          @id @default(uuid())
  church_id             String
  member_id             String
  category_id           String
  amount                Float
  currency              String          @default("NGN")
  frequency             String          // weekly, monthly, quarterly
  payment_reference     String?
  authorization_code    String?         // Paystack authorization code
  is_active             Boolean         @default(true)
  next_charge_date      DateTime?
  last_charge_date      DateTime?
  failed_attempt_count  Int             @default(0)
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  @@index([church_id, member_id])
  @@map("recurring_giving")
}

// ─── Events ──────────────────────────────────────────────

model Event {
  id              String    @id @default(uuid())
  church_id       String
  branch_id       String?
  title           String
  description     String?
  type            EventType @default(service)
  start_date      DateTime
  end_date        DateTime?
  location        String?
  capacity        Int?
  is_free         Boolean   @default(true)
  price           Float?
  registration_fields Json  @default("[]")
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  church            Church              @relation(fields: [church_id], references: [id])
  branch            Branch?             @relation(fields: [branch_id], references: [id])
  registrations     EventRegistration[]
  tickets           Ticket[]

  @@index([church_id, start_date])
  @@map("events")
}

model EventRegistration {
  id          String   @id @default(uuid())
  event_id    String
  member_id   String
  custom_data Json     @default("{}")
  created_at  DateTime @default(now())

  event  Event  @relation(fields: [event_id], references: [id])
  member Member @relation(fields: [member_id], references: [id])

  @@unique([event_id, member_id])
  @@map("event_registrations")
}

model Ticket {
  id          String   @id @default(uuid())
  event_id    String
  code        String   @unique
  member_id   String?
  is_used     Boolean  @default(false)
  used_at     DateTime?
  created_at  DateTime @default(now())

  event Event @relation(fields: [event_id], references: [id])

  @@index([event_id])
  @@map("tickets")
}

// ─── Communication ───────────────────────────────────────

model Message {
  id          String           @id @default(uuid())
  church_id   String
  member_id   String?
  phone       String
  direction   MessageDirection
  channel     String           // whatsapp, sms, email
  content     String?
  media_url   String?
  status      String           @default("sent") // sent, delivered, read, failed
  metadata    Json             @default("{}")
  created_at  DateTime         @default(now())

  church  Church  @relation(fields: [church_id], references: [id])

  @@index([church_id, channel, created_at])
  @@map("messages")
}

model Template {
  id          String   @id @default(uuid())
  church_id   String
  name        String
  content     String
  channel     String   // whatsapp, sms, email
  language    String   @default("en")
  status      String   @default("draft") // draft, published, archived
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([church_id])
  @@map("templates")
}

// ─── Pastoral Care ───────────────────────────────────────

model PastoralNote {
  id                 String              @id @default(uuid())
  church_id          String
  member_id          String
  author_id          String
  content            String              // Encrypted at application level
  confidentiality    ConfidentialityLevel @default(standard)
  tags               String[]
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  member  Member @relation("Subject", fields: [member_id], references: [id])
  author  Member @relation("Author", fields: [author_id], references: [id])

  @@index([church_id, member_id])
  @@map("pastoral_notes")
}

model LifeEvent {
  id          String   @id @default(uuid())
  church_id   String
  member_id   String
  type        String   // birthday, wedding, death, dedication, baptism
  date        DateTime
  details     Json     @default("{}")
  notified    Boolean  @default(false)
  created_at  DateTime @default(now())

  member Member @relation(fields: [member_id], references: [id])

  @@index([church_id, member_id, type])
  @@map("life_events")
}

model RiskScore {
  id          String    @id @default(uuid())
  church_id   String
  member_id   String
  score       Int       // 0-100
  level       RiskLevel
  factors     Json      @default("{}")
  calculated_at DateTime @default(now())

  member Member @relation(fields: [member_id], references: [id])

  @@unique([member_id])
  @@index([church_id, level])
  @@map("risk_scores")
}

model EngagementScore {
  id          String    @id @default(uuid())
  church_id   String
  member_id   String
  score       Int       // 0-100
  factors     Json      @default("{}")
  calculated_at DateTime @default(now())

  member Member @relation(fields: [member_id], references: [id])

  @@unique([member_id])
  @@index([church_id])
  @@map("engagement_scores")
}

// ─── Operations ──────────────────────────────────────────

model Department {
  id          String   @id @default(uuid())
  church_id   String
  name        String
  description String?
  parent_id   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  church            Church            @relation(fields: [church_id], references: [id])
  department_members DepartmentMember[]

  @@index([church_id])
  @@map("departments")
}

model DepartmentMember {
  id            String   @id @default(uuid())
  department_id String
  member_id     String
  role          String   @default("member")
  joined_at     DateTime @default(now())

  department Department @relation(fields: [department_id], references: [id])
  member     Member     @relation(fields: [member_id], references: [id])

  @@unique([department_id, member_id])
  @@map("department_members")
}

model CellGroup {
  id          String   @id @default(uuid())
  church_id   String
  name        String
  leader_id   String?
  latitude    Float?
  longitude   Float?
  meeting_day String?
  meeting_time String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  church Church @relation(fields: [church_id], references: [id])

  @@index([church_id])
  @@map("cell_groups")
}

model Asset {
  id               String    @id @default(uuid())
  church_id        String
  name             String
  description      String?
  category         String?
  purchase_date    DateTime?
  purchase_price   Float?
  current_value    Float?
  location         String?
  status           String    @default("active") // active, maintenance, retired
  qr_code          String?
  maintenance_date DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  church Church @relation(fields: [church_id], references: [id])

  @@index([church_id])
  @@map("assets")
}

// ─── Forms ───────────────────────────────────────────────

model Form {
  id          String     @id @default(uuid())
  church_id   String
  title       String
  description String?
  fields      Json       @default("[]") // Array of field definitions
  status      FormStatus @default(draft)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  submissions FormSubmission[]

  @@index([church_id])
  @@map("forms")
}

model FormSubmission {
  id         String   @id @default(uuid())
  form_id    String
  data       Json
  submitted_by String?
  created_at DateTime @default(now())

  form Form @relation(fields: [form_id], references: [id])

  @@index([form_id])
  @@map("form_submissions")
}

// ─── System ──────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  church_id   String
  user_id     String?
  action      String
  entity      String
  entity_id   String?
  old_values  Json?
  new_values  Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  church Church @relation(fields: [church_id], references: [id])

  @@index([church_id, created_at])
  @@index([entity, entity_id])
  @@map("audit_logs")
}

model ChurchConfig {
  id          String   @id @default(uuid())
  church_id   String
  key         String
  value       Json
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([church_id, key])
  @@map("church_configs")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  permissions RolePermission[]
  created_at  DateTime     @default(now())

  @@map("roles")
}

model Permission {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  resource    String
  action      String       // create, read, update, delete
  roles       RolePermission[]
  created_at  DateTime     @default(now())

  @@map("permissions")
}

model RolePermission {
  id            String @id @default(uuid())
  role_id       String
  permission_id String

  role       Role       @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model SyncQueue {
  id          String   @id @default(uuid())
  church_id   String
  entity      String
  entity_id   String
  action      String   // create, update, delete
  data        Json
  synced      Boolean  @default(false)
  synced_at   DateTime?
  created_at  DateTime @default(now())

  @@index([synced, created_at])
  @@map("sync_queue")
}
