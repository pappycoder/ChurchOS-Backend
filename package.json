{
  "name": "churchos-backend",
  "version": "0.1.0",
  "description": "ChurchOS Backend API \u2014 NestJS + Prisma + Supabase Auth",
  "private": true,
  "license": "GPL-3.0",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test,scripts,prisma}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "prisma:seed-development": "ts-node --project tsconfig.seed.json prisma/seed.ts --development",
    "prisma:seed-production": "ts-node --project tsconfig.seed.json prisma/seed.ts --production",
    "prisma:seed-perms": "ts-node --project tsconfig.seed.json prisma/seed-permissions.ts",
    "prisma:seed-demo-logins": "ts-node --project tsconfig.seed.json prisma/seed-demo-logins.ts",
    "delete-data": "ts-node -P tsconfig.scripts.json scripts/delete-data.ts",
    "delete-data:dry": "ts-node -P tsconfig.scripts.json scripts/delete-data.ts --dry-run",
    "seed-super-admin": "ts-node -P tsconfig.scripts.json scripts/seed-super-admin.ts",
    "backfill-profile-emails": "ts-node -P tsconfig.scripts.json scripts/backfill-profile-emails.ts",
    "update-project-board": "bash scripts/update-project-board.sh",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "start:worker": "node dist/worker",
    "storage:migrate-private": "ts-node -P tsconfig.scripts.json scripts/migrate-private-media.ts",
    "pastoral:rotate-key": "ts-node -P tsconfig.scripts.json scripts/rotate-pastoral-key.ts"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.18",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nestjs": "^10.65.0",
    "@sentry/profiling-node": "^10.65.0",
    "@supabase/supabase-js": "^2.110.6",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bullmq": "^5.80.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.2",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "nestjs-pino": "^4.6.1",
    "otpauth": "^9.5.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.17.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.18",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "source-map-js": "^1.2.2",
    "fast-uri": "^3.1.8",
    "browserslist": "^4.28.7",
    "postcss": "^8.5.23",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "hono": "^4.13.7",
    "@hono/node-server": "^1.19.15",
    "deepmerge-ts": "^8.0.2",
    "valibot": "^1.4.2",
    "mysql2": "^3.23.1",
    "multer": "^2.3.0",
    "js-yaml": "^4.3.2",
    "lodash": "^4.17.24",
    "body-parser": "^2.2.2",
    "brace-expansion@<2": "^1.1.21",
    "brace-expansion@>=4": "^5.0.12",
    "dompurify": "^3.4.16",
    "file-type": "^21.3.2",
    "fast-copy": "^4.1.0",
    "ajv@>=7": "^8.18.0",
    "brace-expansion@>=2 <3": "^2.1.7",
    "handlebars": "^4.7.10",
    "picomatch@>=4": "^4.0.7",
    "@angular-devkit/core": "^19.2.24",
    "@angular-devkit/schematics": "^19.2.24"
  }
}
