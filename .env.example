# ChurchOS Backend Environment Variables

# ─── Application ──────────────────────────────────────────
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

# ─── Database (Prisma + PostgreSQL) ───────────────────────
DATABASE_URL=postgresql://user:password@localhost:5433/churchos

# ─── Supabase (Auth + Storage only) ───────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# Optional: Only needed if using HS256 tokens. ES256 tokens (default for new Supabase projects)
# are verified automatically via the remote JWKS endpoint.
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# ─── Redis (Cache + Queue) ────────────────────────────────
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_TOKEN=your-upstash-redis-token

# ─── Payments ─────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# ─── WhatsApp (360dialog) ─────────────────────────────────
360DIALOG_API_KEY=
360DIALOG_WEBHOOK_SECRET=

# ─── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=

# ─── SMS (Termii) ─────────────────────────────────────────
TERMII_API_KEY=

# ─── AI (Optional) ────────────────────────────────────────
OPENAI_API_KEY=

# ─── Storage (Supabase Storage) ──────────────────────────
SUPABASE_STORAGE_BUCKET=media
MAX_FILE_SIZE_MB=5

# ─── Monitoring (Optional) ────────────────────────────────
SENTRY_DSN=
