# ChurchOS Backend Environment Variables

# ─── Application ──────────────────────────────────────────
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

# ─── Database (Prisma + PostgreSQL) ───────────────────────
DATABASE_URL=postgresql://user:password@localhost:5433/churchos
# Connection pool settings (Prisma 7 + @prisma/adapter-pg)
DB_POOL_MAX=10               # Per-instance pool size for long-running servers; serverless is capped at 1
DB_IDLE_TIMEOUT_MS=10000     # Idle connection timeout (serverless default: 1000ms)
DB_CONNECT_TIMEOUT_MS=15000  # Connection timeout (ms)
# For Supabase serverless deploys, the runtime automatically changes the Supavisor
# session port 5432 to transaction port 6543 and enables pgbouncer compatibility.

# ─── Supabase (Auth + Storage only) ───────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# Optional: Only needed if using HS256 tokens. ES256 tokens (default for new Supabase projects)
# are verified automatically via the remote JWKS endpoint.
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard
SUPABASE_STORAGE_BUCKET=media

# ─── Redis (Cache + Queue) ────────────────────────────────
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_TOKEN=your-upstash-redis-token

# ─── Payments ─────────────────────────────────────────────
# Organization gateway keys: ChurchOS subscriptions only.
# Churches must configure their own gateway accounts in Integrations.
# ChurchOS subscription checkout uses these organization-owned merchant keys.
# Webhooks: /api/v1/billing/webhooks/paystack or /flutterwave; redirects use WEB_URL/subscription.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# SMS sender ID (alphanumeric, 3-11 chars) or device name for WhatsApp
# WhatsApp device ID from the Termii dashboard (Manage Device page)
# Termii webhook signature secret (configured in the Termii developer console)
# Deprecated: shared platform callbacks no longer route messages to churches.
# SMS fallback also requires the church's own configured SMS account.
ENABLE_SMS_FALLBACK=false

# ─── Email (Resend) ───────────────────────────────────────
# Organization/platform authentication mail only; no fallback for church mail.
RESEND_API_KEY=
RESEND_FROM=noreply@churchos.app

# ─── AI (Optional) ────────────────────────────────────────
OPENAI_API_KEY=

# ─── Storage (Supabase Storage) ──────────────────────────
SUPABASE_STORAGE_BUCKET=media
MAX_FILE_SIZE_MB=5

# ─── Pastoral Notes Encryption ───────────────────────────
# AES-256-GCM key for encrypting pastoral note content at rest.
# Minimum 16 characters. Change this for production!
PASTORAL_ENCRYPTION_KEY=dev-only-change-in-production-32b

# ─── Monitoring (Optional) ────────────────────────────────
SENTRY_DSN=

# Required to set up or verify backend authenticator 2FA. Generate: openssl rand -hex 32
# Store in your deployment secret manager; never rotate without re-encrypting existing secrets.
TWO_FACTOR_ENCRYPTION_KEY=

# Audit rollout: public branding and private managed media are separate buckets.
SUPABASE_PRIVATE_STORAGE_BUCKET=media-private
# Use the same random value (at least 32 characters) on web and backend.
# Leave unset in development; configure from a secret manager in production.
# INTERNAL_PROXY_SECRET=
# HTTP instances enqueue work; deploy npm run start:worker on a persistent host.
# ENABLE_QUEUE_WORKERS=false
# Production Swagger is disabled unless explicitly enabled.
# ENABLE_SWAGGER=false
# Only for supervised note-key migration; remove after rotation.
# PASTORAL_OLD_ENCRYPTION_KEY=

# Reusable church provider accounts: dedicated 32-byte hex encryption key.
# Generate once with openssl rand -hex 32; keep stable on API and workers.
INTEGRATIONS_ENCRYPTION_KEY=
# Exact public backend origin (no /api/v1 suffix); required for Twilio signatures
# and automatic outbound status callback URLs. Example: https://api.example.org
PUBLIC_API_URL=
# Platform Flutterwave v3 webhook secret hash, separate from its API secret key.
FLUTTERWAVE_WEBHOOK_SECRET=

# Subscription charge currencies approved on each platform merchant account.
# Add USD only after USD collections are enabled; these do not change church giving.
SUBSCRIPTION_PAYSTACK_CURRENCIES=NGN
SUBSCRIPTION_FLUTTERWAVE_CURRENCIES=NGN
